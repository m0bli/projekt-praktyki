<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Dolna nawigacja -->
    <style name="BottomNavItem">
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_marginHorizontal" tools:targetApi="26">3dp</item>
        <item name="android:background">@drawable/bg_nav_inactive</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="BottomNavIcon">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">23sp</item>
        <item name="android:textColor">@color/theme_text_secondary</item>
    </style>

    <style name="BottomNavLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/theme_text_secondary</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Szybkie akcje: przelew, karty, historia -->
    <style name="QuickAction">
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_height">94dp</item>
        <item name="android:layout_marginHorizontal" tools:targetApi="26">4dp</item>
        <item name="android:background">@drawable/bg_quick_action</item>
        <item name="android:textColor">@color/theme_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">8dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Elementy wysuwanego panelu -->
    <style name="DrawerItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/theme_text</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Pola formularza rejestracji -->
    <style name="RegisterTextInput"
        parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">14dp</item>

        <item name="boxBackgroundMode">outline</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>

        <item name="boxStrokeColor">#0D9488</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">#0D9488</item>
    </style>

    <style name="RegisterEditText"
        parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">

        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">#172554</item>
        <item name="android:textColorHint">#94A3B8</item>
        <item name="android:textSize">16sp</item>
    </style>

</resources>