<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/register"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    tools:context=".RegisterActivity">

    <!-- STAŁY TOOLBAR -->
    <FrameLayout
        android:id="@+id/toolbarContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/app_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/app_bg"
            app:title="Aplaikacja Bankowa"
            app:titleTextColor="@color/black"
            app:navigationIcon="@drawable/ic_arrow_back" />

    </FrameLayout>

    <!-- PRZEWIJANA CZĘŚĆ -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbarContainer"
        app:layout_constraintBottom_toTopOf="@id/btnRegister"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/bank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10sp"
                android:gravity="center"
                android:padding="5dp"
                android:text="Zarejestruj Się"
                android:textColor="@color/black"
                android:textSize="38sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutRegisterImie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/bank"
                android:layout_marginTop="35dp"
                android:padding="5dp"
                android:textColorHint="@color/black"
                app:boxStrokeColor="@color/black"
                app:hintTextColor="@color/black"
                app:errorIconTint="@color/red">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editRegisterImie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:hint="Podaj Imie" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutRegisterNazwisko"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/layoutRegisterImie"
                android:layout_marginTop="15dp"
                android:padding="5dp"
                android:textColorHint="@color/black"
                app:boxStrokeColor="@color/black"
                app:hintTextColor="@color/black"
                app:errorIconTint="@color/red">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editRegisterNazwisko"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:hint="Podaj Nazwisko" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutRegisterLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/layoutRegisterNazwisko"
                android:layout_marginTop="15dp"
                android:padding="5dp"
                android:textColorHint="@color/black"
                app:boxStrokeColor="@color/black"
                app:hintTextColor="@color/black"
                app:errorIconTint="@color/red">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editRegisterLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:hint="Podaj Login" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutRegisterHaslo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/layoutRegisterLogin"
                android:layout_marginTop="15dp"
                android:padding="5dp"
                android:textColorHint="@color/black"
                android:inputType="textPassword"
                app:boxStrokeColor="@color/black"
                app:hintTextColor="@color/black"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="@color/black"
                app:errorIconTint="@color/red">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editRegisterHaslo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:hint="Podaj hasło"
                    android:inputType="textPassword" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutRegisterPotwierdzHaslo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/layoutRegisterHaslo"
                android:layout_marginTop="15dp"
                android:padding="5dp"
                android:textColorHint="@color/black"
                android:inputType="textPassword"
                app:boxStrokeColor="@color/black"
                app:hintTextColor="@color/black"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="@color/black"
                app:errorIconTint="@color/red">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editRegisterPotwierdzHaslo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:hint="Powtórz hasło"
                    android:inputType="textPassword" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/xddddd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/layoutRegisterPotwierdzHaslo"
                android:layout_marginTop="15dp"
                android:padding="5dp"
                android:textColorHint="@color/black"
                android:inputType="textPassword"
                app:boxStrokeColor="@color/black"
                app:hintTextColor="@color/black"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="@color/black"
                app:errorIconTint="@color/red">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/xdddddd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:hint="Powtórz hasło"
                    android:inputType="textPassword" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/xddddd2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/xddddd"
                android:layout_marginTop="15dp"
                android:padding="5dp"
                android:textColorHint="@color/black"
                android:inputType="textPassword"
                app:boxStrokeColor="@color/black"
                app:hintTextColor="@color/black"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="@color/black"
                app:errorIconTint="@color/red">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/xdddddd2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:hint="Powtórz hasło"
                    android:inputType="textPassword" />

            </com.google.android.material.textfield.TextInputLayout>

            <CheckBox
                android:id="@+id/checkboxRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Czy akceptujesz naszą zajebistą polityke prywatności LINK"
                android:layout_below="@id/xddddd2"
                android:layout_marginTop="10dp"
                android:layout_marginLeft="10dp"
                android:textColor="@color/black"/>

        </RelativeLayout>

    </ScrollView>

    <!-- STAŁY PRZYCISK -->
    <Button
        android:id="@+id/btnRegister"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:padding="15dp"
        android:layout_marginLeft="75dp"
        android:layout_marginRight="75dp"
        android:gravity="center"
        android:text="Utwórz konto"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>