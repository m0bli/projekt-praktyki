<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/register"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_background"
    tools:context=".ui.auth.RegisterActivity">

    <!-- Pasek nawigacji -->
    <FrameLayout
        android:id="@+id/toolbarContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/theme_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/theme_background"
            app:title="Tworzenie konta"
            app:titleTextColor="@color/theme_text"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/theme_text" />

    </FrameLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/toolbarContainer"
        app:layout_constraintBottom_toTopOf="@id/btnRegister"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="18dp"
            android:paddingBottom="24dp">

            <!-- header -->
            <TextView
                android:id="@+id/bank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="Rejestracja"
                android:textColor="@color/theme_text"
                android:textSize="30sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/txtSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Utwórz konto, aby rozpocząć"
                android:textColor="@color/theme_text_secondary"
                android:textSize="14sp" />

            <!-- Karta -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/theme_surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/theme_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <!-- Imię -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutRegisterImie"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:hint="Imię"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxStrokeColor="@color/theme_primary"
                        app:hintTextColor="@color/theme_text"
                        app:errorTextColor="@color/theme_transaction_negative"
                        app:boxStrokeErrorColor="@color/theme_transaction_negative"
                        android:textColorHint="@color/theme_text_secondary"
                        app:startIconDrawable="@drawable/ic_person"
                        app:startIconTint="@color/theme_text_secondary"
                        app:errorIconTint="@color/theme_transaction_negative">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editRegisterImie"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:singleLine="true"
                            android:imeOptions="actionNext"
                            android:textColor="@color/theme_text"
                            android:textColorHint="@color/theme_text_secondary"
                            android:textSize="16sp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Nazwisko -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutRegisterNazwisko"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:hint="Nazwisko"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxStrokeColor="@color/theme_primary"
                        app:hintTextColor="@color/theme_text"
                        app:errorTextColor="@color/theme_transaction_negative"
                        app:boxStrokeErrorColor="@color/theme_transaction_negative"
                        android:textColorHint="@color/theme_text_secondary"
                        app:startIconDrawable="@drawable/ic_person"
                        app:startIconTint="@color/theme_text_secondary"
                        app:errorIconTint="@color/theme_transaction_negative">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editRegisterNazwisko"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:singleLine="true"
                            android:imeOptions="actionNext"
                            android:textColor="@color/theme_text"
                            android:textColorHint="@color/theme_text_secondary"
                            android:textSize="16sp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Login -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutRegisterLogin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:hint="Login"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxStrokeColor="@color/theme_primary"
                        app:hintTextColor="@color/theme_text"
                        app:errorTextColor="@color/theme_transaction_negative"
                        app:boxStrokeErrorColor="@color/theme_transaction_negative"
                        android:textColorHint="@color/theme_text_secondary"
                        app:startIconDrawable="@drawable/ic_person"
                        app:startIconTint="@color/theme_text_secondary"
                        app:errorIconTint="@color/theme_transaction_negative">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editRegisterLogin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:singleLine="true"
                            android:imeOptions="actionNext"
                            android:textColor="@color/theme_text"
                            android:textColorHint="@color/theme_text_secondary"
                            android:textSize="16sp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- E-mail -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutRegisterEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:hint="Adres e-mail"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxStrokeColor="@color/theme_primary"
                        app:hintTextColor="@color/theme_text"
                        app:errorTextColor="@color/theme_transaction_negative"
                        app:boxStrokeErrorColor="@color/theme_transaction_negative"
                        android:textColorHint="@color/theme_text_secondary"
                        app:startIconDrawable="@drawable/ic_email"
                        app:startIconTint="@color/theme_text_secondary"
                        app:errorIconTint="@color/theme_transaction_negative">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editRegisterEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:singleLine="true"
                            android:imeOptions="actionNext"
                            android:textColor="@color/theme_text"
                            android:textColorHint="@color/theme_text_secondary"
                            android:textSize="16sp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Hasło -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutRegisterHaslo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:hint="Hasło"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxStrokeColor="@color/theme_primary"
                        app:hintTextColor="@color/theme_text"
                        app:errorTextColor="@color/theme_transaction_negative"
                        app:boxStrokeErrorColor="@color/theme_transaction_negative"
                        android:textColorHint="@color/theme_text_secondary"
                        app:startIconDrawable="@android:drawable/ic_lock_lock"
                        app:startIconTint="@color/theme_text_secondary"
                        app:errorIconTint="@color/theme_transaction_negative"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/theme_text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editRegisterHaslo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:singleLine="true"
                            android:imeOptions="actionNext"
                            android:textColor="@color/theme_text"
                            android:textColorHint="@color/theme_text_secondary"
                            android:textSize="16sp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Potwierdź hasło -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutRegisterPotwierdzHaslo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:hint="Potwierdź hasło"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxStrokeColor="@color/theme_primary"
                        app:hintTextColor="@color/theme_text"
                        app:errorTextColor="@color/theme_transaction_negative"
                        app:boxStrokeErrorColor="@color/theme_transaction_negative"
                        android:textColorHint="@color/theme_text_secondary"
                        app:startIconDrawable="@android:drawable/ic_lock_lock"
                        app:startIconTint="@color/theme_text_secondary"
                        app:errorIconTint="@color/theme_transaction_negative"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/theme_text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editRegisterPotwierdzHaslo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:singleLine="true"
                            android:imeOptions="actionDone"
                            android:textColor="@color/theme_text"
                            android:textColorHint="@color/theme_text_secondary"
                            android:textSize="16sp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <CheckBox
                        android:id="@+id/checkboxRegister"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:buttonTint="@color/theme_primary"
                        android:text="Akceptuję politykę prywatności"
                        android:textColor="@color/theme_text"
                        android:textSize="14sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRegister"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:text="Utwórz konto"
        android:textAllCaps="false"
        android:textColor="@color/theme_on_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/theme_primary"
        app:cornerRadius="14dp"
        app:elevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>