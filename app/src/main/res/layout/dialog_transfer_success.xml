<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialogSuccessRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_popup_rounded">

    <!-- Ikona sukcesu (zielony ptaszek w kółku) -->
    <TextView
        android:id="@+id/iconSuccess"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:gravity="center"
        android:text="✓"
        android:textColor="#10B981"
        android:textSize="32sp"
        android:textStyle="bold"
        android:background="@drawable/bg_notification_dot" />

    <TextView
        android:id="@+id/dialogSuccessTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Przelew zrealizowany!"
        android:textColor="@color/theme_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dialogSuccessSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Środki zostały pomyślnie wysłane"
        android:textColor="@color/theme_text_secondary"
        android:textSize="13sp" />

    <!-- Karta ze szczegółami wysłanego przelewu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_quick_action"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Numer transakcji:"
                android:textColor="@color/theme_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtSuccessTxId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="#10"
                android:textColor="@color/theme_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Kwota:"
                android:textColor="@color/theme_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtSuccessAmount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="150,00 PLN"
                android:textColor="@color/theme_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Odbiorca:"
                android:textColor="@color/theme_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtSuccessRecipient"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Jan Kowalski"
                android:textColor="@color/theme_text"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/btnSuccessDone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_register_button"
        android:gravity="center"
        android:text="Gotowe"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
