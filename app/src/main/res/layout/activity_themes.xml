<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/themesScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/themesRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_nav_inactive"
                android:contentDescription="Wróć"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/theme_text"
                android:textSize="36sp" />

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="Themes"
                android:textColor="@color/theme_text"
                android:textSize="25sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="24dp"
            android:text="Wybierz wygląd swojej aplikacji"
            android:textColor="@color/theme_text_secondary"
            android:textSize="14sp" />

        <!-- Section: Motyw -->
        <TextView
            android:id="@+id/lblSectionTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:text="MOTYW"
            android:textColor="@color/theme_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Option Light -->
        <LinearLayout
            android:id="@+id/itemThemeLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_nav_inactive"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/iconThemeLight"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_quick_action"
                android:gravity="center"
                android:text="☀"
                android:textColor="@color/theme_accent"
                android:textSize="25sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Light"
                    android:textColor="@color/theme_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:text="Jasne tło i niebieskie akcenty"
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/checkThemeLight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textColor="@color/theme_accent"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Option Dark -->
        <LinearLayout
            android:id="@+id/itemThemeDark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_nav_inactive"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/iconThemeDark"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_quick_action"
                android:gravity="center"
                android:text="☾"
                android:textColor="@color/theme_accent"
                android:textSize="25sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dark"
                    android:textColor="@color/theme_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:text="Ciemne tło i jasny tekst"
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/checkThemeDark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textColor="@color/theme_accent"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Section: Kolor Akcentowy -->
        <TextView
            android:id="@+id/lblSectionAccent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:text="KOLOR AKCENTOWY"
            android:textColor="@color/theme_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Accent Option Blue -->
        <LinearLayout
            android:id="@+id/itemAccentBlue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_nav_inactive"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <View
                android:id="@+id/swatchBlue"
                android:layout_width="28dp"
                android:layout_height="28dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="Blue"
                android:textColor="@color/theme_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/checkAccentBlue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Accent Option Green -->
        <LinearLayout
            android:id="@+id/itemAccentGreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_nav_inactive"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <View
                android:id="@+id/swatchGreen"
                android:layout_width="28dp"
                android:layout_height="28dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="Green"
                android:textColor="@color/theme_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/checkAccentGreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Accent Option Purple -->
        <LinearLayout
            android:id="@+id/itemAccentPurple"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_nav_inactive"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <View
                android:id="@+id/swatchPurple"
                android:layout_width="28dp"
                android:layout_height="28dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="Purple"
                android:textColor="@color/theme_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/checkAccentPurple"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Accent Option Red -->
        <LinearLayout
            android:id="@+id/itemAccentRed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_nav_inactive"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <View
                android:id="@+id/swatchRed"
                android:layout_width="28dp"
                android:layout_height="28dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="Red"
                android:textColor="@color/theme_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/checkAccentRed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Accent Option Orange -->
        <LinearLayout
            android:id="@+id/itemAccentOrange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_nav_inactive"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <View
                android:id="@+id/swatchOrange"
                android:layout_width="28dp"
                android:layout_height="28dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="Orange"
                android:textColor="@color/theme_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/checkAccentOrange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textSize="20sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>