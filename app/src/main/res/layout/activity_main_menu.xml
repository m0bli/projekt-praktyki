<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_background">

    <!-- Główna część aplikacji -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Górny pasek -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:background="@color/theme_surface"
            android:elevation="4dp">

            <ImageView
                android:id="@+id/btnProfile"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="11dp"
                android:src="@drawable/ic_profile"
                app:tint="@color/theme_primary"
                android:contentDescription="Otwórz panel profilu"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="MP"
                android:textColor="@color/theme_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <FrameLayout
                android:id="@+id/btnNotifications"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Powiadomienia"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgNotificationIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_notification"
                    app:tint="@color/theme_primary"
                    android:contentDescription="Ikona powiadomień" />

                <View
                    android:id="@+id/notificationBadge"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_notification_dot"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

        <!-- Zmienna zawartość -->
        <FrameLayout
            android:id="@+id/contentFrame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/homeSwipeRefresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

            <ScrollView
                android:id="@+id/homeScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Powitanie -->
                    <TextView
                        android:id="@+id/txtWelcome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Witaj!"
                        android:textColor="@color/theme_text"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <!-- Karta salda -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="190dp"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_balance_card"
                        android:orientation="vertical"
                        android:padding="22dp"
                        android:elevation="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DOSTĘPNE ŚRODKI"
                            android:textColor="#DCE8FF"
                            android:textSize="12sp"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:id="@+id/txtBalance"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="Ładowanie..."
                            android:textColor="#FFFFFF"
                            android:textSize="30sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="Konto osobiste"
                            android:textColor="#DCE8FF"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/txtAccountId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="#—"
                            android:textColor="#DCE8FF"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <!-- Szybkie akcje -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="Szybkie akcje"
                        android:textColor="@color/theme_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <TextView
                            android:id="@+id/actionTransfer"
                            style="@style/QuickAction"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="↗&#10;Przelew" />

                        <TextView
                            android:id="@+id/actionCards"
                            style="@style/QuickAction"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="▣&#10;Karty" />

                        <TextView
                            android:id="@+id/actionHistory"
                            style="@style/QuickAction"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="◷&#10;Historia" />

                    </LinearLayout>

                    <!-- Ostatnie transakcje -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="Ostatnie transakcje"
                        android:textColor="@color/theme_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/recentTransactionsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@color/theme_surface"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:elevation="1dp" />

                </LinearLayout>
            </ScrollView>
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        </FrameLayout>

        <!-- Dolna nawigacja -->
        <!-- TODO: NAWIGACJA WSZEDZIE -->
        <LinearLayout
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="7dp"
            android:background="@color/theme_surface"
            android:elevation="8dp">

            <LinearLayout
                android:id="@+id/navHome"
                style="@style/BottomNavItem"
                android:layout_width="0dp"
                android:layout_weight="1">

                <TextView
                    style="@style/BottomNavIcon"
                    android:text="⌂" />

                <TextView
                    style="@style/BottomNavLabel"
                    android:text="Start" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navPayments"
                style="@style/BottomNavItem"
                android:layout_width="0dp"
                android:layout_weight="1">

                <TextView
                    style="@style/BottomNavIcon"
                    android:text="⇄" />

                <TextView
                    style="@style/BottomNavLabel"
                    android:text="Płatności" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navCards"
                style="@style/BottomNavItem"
                android:layout_width="0dp"
                android:layout_weight="1">

                <TextView
                    style="@style/BottomNavIcon"
                    android:text="▣" />

                <TextView
                    style="@style/BottomNavLabel"
                    android:text="Karty" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navMore"
                style="@style/BottomNavItem"
                android:layout_width="0dp"
                android:layout_weight="1">

                <TextView
                    style="@style/BottomNavIcon"
                    android:text="•••" />

                <TextView
                    style="@style/BottomNavLabel"
                    android:text="Więcej" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- Panel wysuwany z lewej strony -->
    <LinearLayout
        android:id="@+id/profileDrawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@color/theme_surface"
        android:elevation="16dp">

        <!-- Nagłówek panelu profilu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="155dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:background="@drawable/bg_balance_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="bank"
                android:textColor="#DCE8FF"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Twój profil"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/drawerProfile"
            style="@style/DrawerItem"
            android:text="♙   Moje dane" />

        <TextView
            android:id="@+id/drawerSettings"
            style="@style/DrawerItem"
            android:text="⚙   Ustawienia" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/theme_divider" />

        <TextView
            android:id="@+id/btnLogout"
            style="@style/DrawerItem"
            android:text="↪   Wyloguj się"
            android:textColor="@color/theme_transaction_negative" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>