<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_background">

    <!-- Główna część aplikacji -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Górny pasek -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:background="@color/theme_surface"
            android:elevation="4dp">

            <ImageView
                android:id="@+id/btnProfile"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="11dp"
                android:src="@drawable/ic_profile"
                app:tint="@color/theme_primary"
                android:contentDescription="Otwórz panel profilu"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="bank"
                android:textColor="@color/theme_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <FrameLayout
                android:id="@+id/btnNotifications"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Powiadomienia"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgNotificationIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_notification"
                    app:tint="@color/theme_primary"
                    android:contentDescription="Ikona powiadomień" />

                <View
                    android:id="@+id/notificationBadge"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_notification_dot"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

        <!-- Zmienna zawartość -->
        <FrameLayout
            android:id="@+id/contentFrame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/homeSwipeRefresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

            <ScrollView
                android:id="@+id/homeScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Powitanie -->
                    <TextView
                        android:id="@+id/txtWelcome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Witaj!"
                        android:textColor="@color/theme_text"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <!-- Karta salda -->
                    <LinearLayout
                        android:id="@+id/balanceCard"
                        android:layout_width="match_parent"
                        android:layout_height="195dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_balance_card"
                        android:orientation="vertical"
                        android:padding="22dp"
                        android:elevation="6dp">

                        <!-- Górny rząd: Etykieta + Chip typu konta -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:text="DOSTĘPNE ŚRODKI"
                                android:textColor="#93C5FD"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="@drawable/bg_card_badge"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="Konto osobiste"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <!-- Środek: Saldo -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtBalance"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Ładowanie..."
                                android:textColor="#FFFFFF"
                                android:textSize="38sp"
                                android:textStyle="bold"
                                android:letterSpacing="-0.02" />

                        </LinearLayout>

                        <!-- Dolny rząd: Numer konta -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="NUMER KONTA"
                                    android:textColor="#BFDBFE"
                                    android:textSize="10sp"
                                    android:letterSpacing="0.08" />

                                <TextView
                                    android:id="@+id/txtAccountId"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="—"
                                    android:textColor="#FFFFFF"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </RelativeLayout>

                    </LinearLayout>

                    <!-- Szybkie akcje -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="Szybkie akcje"
                        android:textColor="@color/theme_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Szybkie akcje -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <!-- Przelew -->
                        <LinearLayout
                            android:id="@+id/actionTransfer"
                            android:layout_width="0dp"
                            android:layout_height="88dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_quick_action"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/iconActionTransfer"
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:background="@drawable/bg_nav_inactive"
                                android:gravity="center"
                                android:text="⇄"
                                android:textColor="@color/theme_primary"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/labelActionTransfer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Przelew"
                                android:textColor="@color/theme_text"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Karty -->
                        <LinearLayout
                            android:id="@+id/actionCards"
                            android:layout_width="0dp"
                            android:layout_height="88dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="3dp"
                            android:background="@drawable/bg_quick_action"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/iconActionCards"
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:background="@drawable/bg_nav_inactive"
                                android:gravity="center"
                                android:text="▣"
                                android:textColor="@color/theme_primary"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/labelActionCards"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Karty"
                                android:textColor="@color/theme_text"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Historia -->
                        <LinearLayout
                            android:id="@+id/actionHistory"
                            android:layout_width="0dp"
                            android:layout_height="88dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_quick_action"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/iconActionHistory"
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:background="@drawable/bg_nav_inactive"
                                android:gravity="center"
                                android:text="◷"
                                android:textColor="@color/theme_primary"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/labelActionHistory"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Historia"
                                android:textColor="@color/theme_text"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Ostatnie transakcje -->
                    <TextView
                        android:id="@+id/txtRecentTransactionsTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="Ostatnie transakcje"
                        android:textColor="@color/theme_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtRecentTransactionsDateRange"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="od 23.03.2026 do 30.03.2026"
                        android:textColor="@color/theme_text_secondary"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/recentTransactionsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical" />

                </LinearLayout>
            </ScrollView>
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        </FrameLayout>

        <!-- Dolna nawigacja -->
        <!-- TODO: NAWIGACJA WSZEDZIE -->
        <LinearLayout
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="7dp"
            android:background="@color/theme_surface"
            android:elevation="8dp">

            <LinearLayout
                android:id="@+id/navHome"
                style="@style/BottomNavItem"
                android:layout_width="0dp"
                android:layout_weight="1">

                <TextView
                    style="@style/BottomNavIcon"
                    android:text="⌂" />

                <TextView
                    style="@style/BottomNavLabel"
                    android:text="Start" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navPayments"
                style="@style/BottomNavItem"
                android:layout_width="0dp"
                android:layout_weight="1">

                <TextView
                    style="@style/BottomNavIcon"
                    android:text="⇄" />

                <TextView
                    style="@style/BottomNavLabel"
                    android:text="Płatności" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navCards"
                style="@style/BottomNavItem"
                android:layout_width="0dp"
                android:layout_weight="1">

                <TextView
                    style="@style/BottomNavIcon"
                    android:text="▣" />

                <TextView
                    style="@style/BottomNavLabel"
                    android:text="Karty" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navMore"
                style="@style/BottomNavItem"
                android:layout_width="0dp"
                android:layout_weight="1">

                <TextView
                    style="@style/BottomNavIcon"
                    android:text="⚙" />

                <TextView
                    style="@style/BottomNavLabel"
                    android:text="Ustawienia" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- Panel wysuwany z lewej strony -->
    <LinearLayout
        android:id="@+id/profileDrawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@color/theme_surface"
        android:elevation="16dp">

        <!-- Nagłówek panelu profilu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="155dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:background="@drawable/bg_balance_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="bank"
                android:textColor="#DCE8FF"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Twój profil"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/drawerProfile"
            style="@style/DrawerItem"
            android:text="♙   Moje dane" />

        <TextView
            android:id="@+id/drawerSettings"
            style="@style/DrawerItem"
            android:text="⚙   Ustawienia" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/theme_divider" />

        <TextView
            android:id="@+id/btnLogout"
            style="@style/DrawerItem"
            android:text="↪   Wyloguj się"
            android:textColor="@color/theme_transaction_negative" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>