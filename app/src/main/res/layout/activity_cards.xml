<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardsScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="28dp"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/cardsRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBackCards"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_nav_inactive"
                android:contentDescription="Wróć"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/theme_text"
                android:textSize="36sp" />

            <TextView
                android:id="@+id/txtCardsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="Karty"
                android:textColor="@color/theme_text"
                android:textSize="25sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtCardsSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:text="Zarządzaj kartą, jej blokadą i limitem płatności."
            android:textColor="@color/theme_text_secondary"
            android:textSize="14sp" />

        <!-- Card View Container -->
        <LinearLayout
            android:id="@+id/cardContainer"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_credit_card"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- Top Row: Brand & Chip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=" •  DEBIT"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Card Chip -->
                <View
                    android:layout_width="38dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_card_chip" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.1"
                android:text="KARTA DEBETOWA"
                android:textColor="#93C5FD"
                android:textSize="10sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Card Number -->
            <TextView
                android:id="@+id/txtCardNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.15"
                android:text="••••  ••••  ••••  1024"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Card Bottom: Holder & Expiry -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtCardHolder"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="WŁAŚCICIEL KONTA"
                    android:textColor="#DBEAFE"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WAŻNA DO 12/30"
                    android:textColor="#DBEAFE"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Reveal Button -->
        <Button
            android:id="@+id/btnRevealCard"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_nav_inactive"
            android:text="Pokaż dane karty"
            android:textColor="@color/theme_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Section 1: Ustawienia konta -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="Ustawienia konta"
            android:textColor="@color/theme_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Switch Item: Zablokuj konto -->
        <LinearLayout
            android:id="@+id/itemBlockAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_nav_inactive"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zablokuj konto"
                    android:textColor="@color/theme_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="3dp"
                    android:text="Blokuje możliwość wykonywania przelewów wychodzących."
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchBlocked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Zablokuj konto" />
        </LinearLayout>

        <!-- Section 2: Dzienny limit płatności -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="Dzienny limit płatności"
            android:textColor="@color/theme_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_nav_inactive"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtLimitValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 500,00 PLN"
                    android:textColor="@color/theme_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="3dp"
                    android:text="Maksymalna kwota jednego przelewu."
                    android:textColor="@color/theme_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnChangeLimit"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_quick_action"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Zmień"
                android:textColor="@color/theme_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>