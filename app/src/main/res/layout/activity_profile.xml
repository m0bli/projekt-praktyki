<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profileSwipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/profileScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/theme_background"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/profileRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Nagłówek -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnBackProfile"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_nav_inactive"
                    android:contentDescription="Wróć"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="@color/theme_text"
                    android:textSize="36sp" />

                <TextView
                    android:id="@+id/txtProfileTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Moje dane"
                    android:textColor="@color/theme_text"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/profileProgressBar"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtProfileSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:paddingBottom="20dp"
                android:text="Informacje o koncie i dane osobowe"
                android:textColor="@color/theme_text_secondary"
                android:textSize="14sp" />

            <!-- Karta Nagłówkowa Profilu (Avatar, Imię Nazwisko, Status) -->
            <LinearLayout
                android:id="@+id/cardProfileHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_balance_card"
                android:elevation="4dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:id="@+id/txtAvatarInitials"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_quick_action"
                    android:gravity="center"
                    android:text="- -"
                    android:textColor="@color/theme_primary"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtHeaderFullName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="- -"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtHeaderStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_quick_action"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="Konto aktywne"
                        android:textColor="#10B981"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- Sekcja 1: Dane osobowe -->
            <TextView
                android:id="@+id/sectionPersonalData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingTop="8dp"
                android:paddingBottom="10dp"
                android:text="DANE OSOBOWE"
                android:textColor="@color/theme_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Imię i Nazwisko -->
            <LinearLayout
                android:id="@+id/itemFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_nav_inactive"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:id="@+id/iconFullName"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_quick_action"
                    android:contentDescription="Ikona imię"
                    android:padding="12dp"
                    android:src="@drawable/ic_person"
                    app:tint="@color/theme_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Imię i Nazwisko"
                        android:textColor="@color/theme_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/valFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="2dp"
                        android:text="Ładowanie..."
                        android:textColor="@color/theme_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Nazwa użytkownika / Login -->
            <LinearLayout
                android:id="@+id/itemLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_nav_inactive"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:id="@+id/iconLogin"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_quick_action"
                    android:contentDescription="Ikona login"
                    android:padding="12dp"
                    android:src="@drawable/ic_person"
                    app:tint="@color/theme_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblLogin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nazwa użytkownika (Login)"
                        android:textColor="@color/theme_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/valLogin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="2dp"
                        android:text="Ładowanie..."
                        android:textColor="@color/theme_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- E-mail -->
            <LinearLayout
                android:id="@+id/itemEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_nav_inactive"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:id="@+id/iconEmail"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_quick_action"
                    android:contentDescription="Ikona email"
                    android:padding="12dp"
                    android:src="@drawable/ic_email"
                    app:tint="@color/theme_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Adres e-mail"
                        android:textColor="@color/theme_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/valEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="2dp"
                        android:text="Ładowanie..."
                        android:textColor="@color/theme_text"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/txtEmailInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="3dp"
                        android:text="Adres email jest potrzebny do robienia przelewów"
                        android:textColor="@color/theme_text_secondary"
                        android:textSize="11sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/btnShowEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_quick_action"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Pokaż"
                    android:textColor="@color/theme_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnHideEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_quick_action"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="Schowaj"
                    android:textColor="@color/theme_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnCopyEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_quick_action"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="Kopiuj"
                    android:textColor="@color/theme_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Sekcja 2: Identyfikator konta -->
            <TextView
                android:id="@+id/sectionAccountData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingTop="8dp"
                android:paddingBottom="10dp"
                android:text="IDENTYFIKACJA KONTA"
                android:textColor="@color/theme_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- ID Użytkownika -->
            <LinearLayout
                android:id="@+id/itemUserId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_nav_inactive"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:id="@+id/iconUserId"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_quick_action"
                    android:contentDescription="Ikona ID użytkownika"
                    android:padding="12dp"
                    android:src="@drawable/ic_person"
                    app:tint="@color/theme_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblUserId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ID Użytkownika"
                        android:textColor="@color/theme_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/valUserId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="2dp"
                        android:text="—"
                        android:textColor="@color/theme_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- ID Konta -->
            <LinearLayout
                android:id="@+id/itemAccountId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_nav_inactive"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:id="@+id/iconAccountId"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_quick_action"
                    android:contentDescription="Ikona ID konta"
                    android:padding="12dp"
                    android:src="@drawable/ic_person"
                    app:tint="@color/theme_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblAccountId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ID Konta"
                        android:textColor="@color/theme_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/valAccountId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="2dp"
                        android:text="—"
                        android:textColor="@color/theme_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnCopyAccountId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_quick_action"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="Kopiuj"
                    android:textColor="@color/theme_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Pełny Numer Konta Bankowego (Wymaga hasła) -->
            <LinearLayout
                android:id="@+id/itemFullAccountNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_nav_inactive"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:id="@+id/iconFullAccountNumber"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_quick_action"
                    android:contentDescription="Ikona pełny numer konta"
                    android:padding="12dp"
                    android:src="@drawable/ic_kwota"
                    app:tint="@color/theme_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblFullAccountNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pełny numer konta bankowego"
                        android:textColor="@color/theme_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/valFullAccountNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="2dp"
                        android:text="PL •••• •••• •••• •••• •••• ••••"
                        android:textColor="@color/theme_text"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnShowFullAccountNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_quick_action"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Pokaż"
                    android:textColor="@color/theme_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnHideFullAccountNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_quick_action"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="Schowaj"
                    android:textColor="@color/theme_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnCopyFullAccountNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_quick_action"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="Kopiuj"
                    android:textColor="@color/theme_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Sekcja 3: Bezpieczeństwo -->
            <TextView
                android:id="@+id/sectionSecurityData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingTop="8dp"
                android:paddingBottom="10dp"
                android:text="BEZPIECZEŃSTWO"
                android:textColor="@color/theme_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Zmiana Hasła -->
            <LinearLayout
                android:id="@+id/itemChangePassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_nav_inactive"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:id="@+id/iconChangePassword"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_quick_action"
                    android:contentDescription="Ikona zmiana hasła"
                    android:padding="12dp"
                    android:src="@android:drawable/ic_lock_lock"
                    app:tint="@color/theme_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblChangePassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Hasło do konta"
                        android:textColor="@color/theme_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/subChangePassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="2dp"
                        android:text="Zmień swoje hasło logowania"
                        android:textColor="@color/theme_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnChangePassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_quick_action"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Zmień"
                    android:textColor="@color/theme_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtProfileFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:text="Bank3 • Moje dane"
                android:textColor="@color/theme_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
