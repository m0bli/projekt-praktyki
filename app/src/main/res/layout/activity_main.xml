<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_background"
    tools:context=".ui.auth.MainActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="36dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/bank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="bank"
                android:textColor="@color/theme_text"
                android:textSize="30sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:cardBackgroundColor="@color/theme_surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/theme_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Zaloguj się"
                        android:textColor="@color/theme_text"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/loginLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:hint="Podaj login lub e-mail"
                        android:textColorHint="@color/theme_text_secondary"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxStrokeColor="@color/theme_primary"
                        app:hintTextColor="@color/theme_text"
                        app:errorTextColor="@color/theme_transaction_negative"
                        app:boxStrokeErrorColor="@color/theme_transaction_negative"
                        app:startIconDrawable="@drawable/sprint"
                        app:startIconTint="@color/theme_text_secondary"
                        app:errorIconTint="@color/theme_transaction_negative">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editLogin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:singleLine="true"
                            android:imeOptions="actionNext"
                            android:textColor="@color/theme_text"
                            android:textColorHint="@color/theme_text_secondary"
                            android:textSize="16sp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/hasloLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:hint="Hasło"
                        android:textColorHint="@color/theme_text_secondary"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxStrokeColor="@color/theme_primary"
                        app:hintTextColor="@color/theme_text"
                        app:errorTextColor="@color/theme_transaction_negative"
                        app:boxStrokeErrorColor="@color/theme_transaction_negative"
                        app:startIconDrawable="@android:drawable/ic_lock_lock"
                        app:startIconTint="@color/theme_text_secondary"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/theme_text_secondary"
                        app:errorIconTint="@color/theme_transaction_negative">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editHaslo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:singleLine="true"
                            android:imeOptions="actionDone"
                            android:textColor="@color/theme_text"
                            android:textColorHint="@color/theme_text_secondary"
                            android:textSize="16sp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/btnRegister"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_gravity="end"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="2dp"
                        android:text="Nie masz konta? Zarejestruj się"
                        android:textColor="@color/theme_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground" />

                    <TextView
                        android:id="@+id/errorText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/theme_transaction_negative"
                        android:textSize="13sp"
                        android:accessibilityLiveRegion="polite" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogin"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Zaloguj się"
                        android:textAllCaps="false"
                        android:textColor="@color/theme_on_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/theme_primary"
                        app:cornerRadius="14dp"
                        app:elevation="2dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="v0.0.1"
                android:textColor="@color/theme_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>