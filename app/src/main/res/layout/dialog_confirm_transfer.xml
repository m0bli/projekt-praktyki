<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialogConfirmRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_popup_rounded">

    <TextView
        android:id="@+id/dialogConfirmTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Potwierdź przelew"
        android:textColor="@color/theme_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Karta podsumowania kwoty -->
    <LinearLayout
        android:id="@+id/confirmAmountCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_quick_action"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KWOTA PRZELEWU"
            android:textColor="@color/theme_text_secondary"
            android:textSize="11sp"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/txtConfirmAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="150,00 PLN"
            android:textColor="@color/theme_primary"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Szczegóły przelewu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="Odbiorca:"
                android:textColor="@color/theme_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtConfirmRecipient"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Jan Kowalski"
                android:textColor="@color/theme_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="Numer konta:"
                android:textColor="@color/theme_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtConfirmAccount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="12 3456 ..."
                android:textColor="@color/theme_text"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="Tytuł:"
                android:textColor="@color/theme_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtConfirmTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Za zakupy"
                android:textColor="@color/theme_text"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Przyciski akcji -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnConfirmCancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_nav_inactive"
            android:gravity="center"
            android:text="Popraw"
            android:textColor="@color/theme_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnConfirmSubmit"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_register_button"
            android:gravity="center"
            android:text="Wyślij przelew"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
